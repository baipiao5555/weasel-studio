<Application x:Class="WeaselStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WeaselStudio.ViewModels"
             xmlns:views="clr-namespace:WeaselStudio.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SchemasViewModel}">
                <views:SchemasView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppearanceViewModel}">
                <views:AppearanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdvancedViewModel}">
                <views:AdvancedView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
