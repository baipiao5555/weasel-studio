<UserControl x:Class="WeaselStudio.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FEF3C7"
                        CornerRadius="9"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="未保存" Foreground="#B45309" FontSize="11" />
                </Border>
                <Button Content="刷新文件"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ReloadFilesCommand}" />
                <Button Content="重新加载"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ReloadContentCommand}"
                        Margin="8,0,0,0" />
                <Button Content="保存"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SaveCommand}"
                        Margin="8,0,0,0" />
                <Button Content="保存并部署"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveAndDeployCommand}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="16,14"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="文件"
                               Style="{StaticResource HintText}"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Files}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              MinHeight="34"
                              Margin="10,0,10,0" />
                    <Button Grid.Column="2"
                            Content="打开所在目录"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenFolderCommand}" />
                </Grid>

                <TextBlock Text="{Binding SelectedFile.Path}"
                           Style="{StaticResource HintText}"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SelectedFile.Path}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationError}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ValidationError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Padding="12">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBox Style="{StaticResource EditorTextBox}"
                         Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10"
                         MinHeight="360" />
            </Border>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource HintText}"
                   Margin="0,12,0,0" />
    </Grid>
</UserControl>
