<UserControl x:Class="WeaselStudio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource CardStyle}"
                    Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    Visibility="{Binding Environment.IsFound, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="没有找到小狼毫"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#9A3412" />
                    <TextBlock Text="请先安装小狼毫（Weasel），或确认注册表中的 RimeUserDir / WeaselRoot 是否正确。"
                               Style="{StaticResource HintText}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    Visibility="{Binding Environment.IsCustomUserDir, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="测试模式"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1D4ED8" />
                    <TextBlock Text="当前使用自定义用户目录，所有读写只作用于该目录；部署已禁用，不会影响正在使用的小狼毫。"
                               Style="{StaticResource HintText}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="环境状态" Style="{StaticResource SectionTitleText}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="用户目录" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding UserDataDir}"
                                       Style="{StaticResource ValueText}"
                                       ToolTip="{Binding UserDataDir}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="程序目录" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding WeaselRoot}"
                                       Style="{StaticResource ValueText}"
                                       ToolTip="{Binding WeaselRoot}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="部署器" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DeployerPath}"
                                       Style="{StaticResource ValueText}"
                                       ToolTip="{Binding DeployerPath}" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Version}"
                                       Style="{StaticResource ValueText}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开用户目录"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenUserDirCommand}" />
                            <Button Content="打开程序目录"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenWeaselDirCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="当前方案" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding CurrentSchemaName}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentSchemaId}"
                                   Style="{StaticResource HintText}"
                                   Margin="0,4,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="9"
                                    Padding="9,4">
                                <TextBlock Text="{Binding EnabledSchemaCount, StringFormat='已启用 {0} 个方案'}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding SchemaCount, StringFormat='共 {0} 个方案文件'}"
                                       Style="{StaticResource HintText}"
                                       Margin="10,3,0,0" />
                        </StackPanel>

                        <Button Content="管理输入方案"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Margin="-10,12,0,0"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="schemas" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="配置概况" Style="{StaticResource SectionTitleText}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自定义文件" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CustomFileCount, StringFormat='{}{0} 个 *.custom.yaml'}"
                                       Style="{StaticResource ValueText}" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最近备份" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BackupText}"
                                       Style="{StaticResource ValueText}"
                                       ToolTip="{Binding BackupDirectory}" />
                        </Grid>

                        <Button Content="打开备份目录"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenBackupsCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="快捷操作" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="保存只会写入 *.custom.yaml；部署会调用 WeaselDeployer.exe /deploy，可能需要几秒。"
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,14" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="立即部署"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding DeployCommand}" />
                            <Button Content="刷新概览"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
