<UserControl x:Class="WeaselStudio.Views.DictionaryStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="一键下载并安装常用词典；只允许 HTTPS 和固定 SHA-256，安装前备份，完成后自动部署。"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重新加载"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ReloadCommand}" />
                <Button Content="打开用户目录"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenUserDirCommand}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Packages}" Margin="0,0,4,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <Border Background="#DCFCE7"
                                                CornerRadius="9"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="已安装" Foreground="#166534" FontSize="11" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource HintText}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding SizeText}"
                                                   Style="{StaticResource HintText}"
                                                   Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding License, StringFormat=授权：{0}}"
                                                   Style="{StaticResource HintText}"
                                                   Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding SchemasText, StringFormat=方案：{0}}"
                                                   Style="{StaticResource HintText}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding SourceUrl}"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                    <TextBlock Text="{Binding StatusText}"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12" />
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Progress}"
                                                 Height="6"
                                                 Margin="0,8,0,8"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Right"
                                            MinWidth="96">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Content" Value="安装" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Content" Value="安装中…" />
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource HintText}" />
                <TextBlock Text="安装会排除 default.yaml、weasel.yaml 和 custom_phrase.txt，避免覆盖你的现有配置；其余文件会先备份再写入。"
                           Style="{StaticResource HintText}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
