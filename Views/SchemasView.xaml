<UserControl x:Class="WeaselStudio.Views.SchemasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#FEF3C7"
                        CornerRadius="9"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="未保存" Foreground="#B45309" FontSize="11" />
                </Border>
                <Button Content="刷新"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" />
                <Button Content="保存"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SaveCommand}"
                        Margin="8,0,0,0" />
                <Button Content="保存并部署"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveAndDeployCommand}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="勾选启用，取消勾选即从方案列表中移除。"
                               Style="{StaticResource HintText}"
                               Margin="0,0,0,10" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Schemas}"
                             SelectedItem="{Binding SelectedSchema}"
                             ItemContainerStyle="{StaticResource SchemaListItem}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetaText}"
                                                   Style="{StaticResource HintText}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="#FEF3C7"
                                            CornerRadius="8"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="文件缺失"
                                                   Foreground="#B45309"
                                                   FontSize="10" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button Content="上移"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MoveUpCommand}" />
                        <Button Content="下移"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MoveDownCommand}"
                                Margin="8,0,0,0" />
                        <Button Content="设为默认"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SetDefaultCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="方案详情" Style="{StaticResource SectionTitleText}" />

                    <TextBlock Text="从左侧选择一个方案查看详情。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSchema}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSchema}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding SelectedSchema.Name}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedSchema.Id}"
                                   Style="{StaticResource HintText}"
                                   Margin="0,4,0,14" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedSchema.Version, TargetNullValue=—}"
                                       Style="{StaticResource ValueText}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="作者" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedSchema.Author}"
                                       Style="{StaticResource ValueText}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件" Style="{StaticResource HintText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedSchema.FilePath}"
                                       Style="{StaticResource ValueText}"
                                       ToolTip="{Binding SelectedSchema.FilePath}" />
                        </Grid>

                        <TextBlock Text="描述"
                                   Style="{StaticResource FieldLabelText}"
                                   Margin="0,4,0,6" />
                        <Border Background="{StaticResource SoftFillBrush}"
                                CornerRadius="8"
                                Padding="12"
                                MaxHeight="220">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedSchema.DescriptionText}"
                                           Style="{StaticResource ValueText}"
                                           LineHeight="21" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource HintText}"
                   Margin="0,12,0,0" />
    </Grid>
</UserControl>
